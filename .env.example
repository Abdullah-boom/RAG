# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used when the main model hits its free-tier tokens-per-minute limit
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Read-only MongoDB user (same string you use in Compass)
MONGO_URI=mongodb+srv://readonly_user:password@cluster.example.net/

EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Website API (make api / docker compose)
# Redis keeps chat memory across restarts and workers. Empty = in-process memory (dev only).
REDIS_URL=
SESSION_TTL_MIN=1440
# Comma-separated origins allowed to call the API (your website, plus the widget dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
RATE_LIMIT_PER_MIN=20
# true only behind a reverse proxy you control (nginx), so X-Forwarded-For can be trusted
TRUST_PROXY=false
API_DEBUG=false
