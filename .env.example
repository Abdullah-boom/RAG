# Copy to .env and fill in. Never commit .env.
# LLM: ollama (local, default) or groq
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
# In Docker use http://host.docker.internal:11434 to reach Ollama on the host
OLLAMA_BASE_URL=http://localhost:11434
# Seconds per chat turn before the "assistant is busy" fallback. 20 suits Groq/GPU; a CPU-only laptop needs ~90-120
# Context window for Ollama calls (tokens); 16384 fits a T4 with an 8B model
OLLAMA_NUM_CTX=16384
LLM_TIME_BUDGET_S=20
# "user:password" if Ollama is behind a tunnel with basic auth (e.g. ngrok on Colab); empty for local Ollama
OLLAMA_AUTH=
# Past exchanges sent to the LLM each turn. 6 for Groq; 1-2 for a small local model (7B and below),
# which otherwise copies earlier answers instead of calling tools.
HISTORY_TURNS=6

# The understanding call (one short JSON call per message) can use a different provider: e.g. openrouter for a
# large model that reads Urdu script and context well, while replies stay on Ollama. Empty = same as LLM_PROVIDER.
PLANNER_PROVIDER=

# Only used when LLM_PROVIDER or PLANNER_PROVIDER is openrouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Only used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used when the main model hits its free-tier tokens-per-minute limit
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Read-only MongoDB user (same string you use in Compass)
MONGO_URI=mongodb+srv://readonly_user:password@cluster.example.net/

EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Website API (make api / docker compose)
# Redis keeps chat memory across restarts and workers. Empty = in-process memory (dev only).
REDIS_URL=
SESSION_TTL_MIN=1440
# Carts (one per customer per branch) expire after this many days untouched
CART_TTL_DAYS=30

# Order hand-off: the main backend endpoint that places orders from a confirmed cart (and returns a status).
# Empty = not connected yet: confirming tells the customer to complete the order in the app.
ORDER_BACKEND_URL=
ORDER_BACKEND_KEY=
# Signs order-confirm tokens (defaults to JWT_SECRET); set it when running several workers without JWT_SECRET
CHECKOUT_SECRET=
# Comma-separated origins allowed to call the API (your website, plus the widget dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
RATE_LIMIT_PER_MIN=20
# true only behind a reverse proxy you control (nginx), so X-Forwarded-For can be trusted
TRUST_PROXY=false
API_DEBUG=false

# Login: verify the main app's JWT so order questions work. Set ONE of the three below to match how
# the Express backend signs tokens. None set = everyone is a guest (order tools disabled).
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
# Defaults: HS256 with JWT_SECRET, RS256 with a public key / JWKS
JWT_ALGORITHMS=
# Claim(s) holding the customer id, first present wins; must equal orders.customerId. Dotted paths work.
# Run `make check-token TOKEN=<a real app token>` to see which claim your tokens use.
JWT_USER_CLAIM=sub,id,_id,userId,customerId
JWT_AUDIENCE=
JWT_ISSUER=
AUTH_REQUIRED=false

# LOCAL TESTING ONLY: lets widget/demo.html log in as any customer (needs JWT_SECRET). Never true on a server.
DEV_LOGIN=false
